rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile, preferences, and account documents
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number != null);
      
      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number != null);
      }
      
      // Coupons subcollection
      match /coupons/{couponId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number != null);
      }

      // Preferences subcollection (including privacy / cookie consent)
      match /preferences/{prefId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number != null);
      }
    }

    // Vertical Carts
    match /grokly_carts/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number != null);
    }

    match /swadishtt_carts/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number != null);
    }

    match /instastyle_carts/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number != null);
    }

    // Vertical Wishlists
    match /instastyle_wishlists/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number != null);
    }

    match /grokly_wishlists/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number != null);
    }

    // User Bookmarks
    match /userBookmarks/{docId} {
      allow read, write: if request.auth != null;
    }

    // Catalog & Blogs (Public read)
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /instastyle_products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Waitlist collection
    match /waitlistUsers/{docId} {
      allow create: if true;
      allow read: if request.auth != null;
    }
    
    // Referral profiles and visits
    match /referralProfiles/{phone} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /referralVisits/{visitId} {
      allow read, create, update: if true;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile, account documents, and all subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number != null);
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number != null);
      }
    }
    
    // Carts and wishlists per user/device
    match /swadishtt_carts/{docId} {
      allow read, write: if true;
    }
    match /grokly_carts/{docId} {
      allow read, write: if true;
    }
    match /instastyle_carts/{docId} {
      allow read, write: if true;
    }
    match /instastyle_wishlists/{docId} {
      allow read, write: if true;
    }

    // Orders collection
    match /orders/{orderId} {
      allow read, create, update: if true;
    }
    
    // Waitlist collection
    match /waitlistUsers/{docId} {
      allow create: if true;
      allow read: if request.auth != null;
    }
    
    // Referral profiles and visits
    match /referralProfiles/{phone} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /referralVisits/{visitId} {
      allow read, create, update: if true;
    }

    // Custom products / catalog
    match /custom_products/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}


rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and account documents
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number != null);
      
      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number != null);
      }
      
      // Coupons subcollection
      match /coupons/{couponId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number != null);
      }
    }
    
    // Waitlist collection
    match /waitlistUsers/{docId} {
      allow create: if true;
      allow read: if request.auth != null;
    }
    
    // Referral profiles and visits
    match /referralProfiles/{phone} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /referralVisits/{visitId} {
      allow read, create, update: if true;
    }
  }
}

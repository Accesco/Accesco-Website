rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and ownership validation
    function isAuthenticated() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (request.auth.token.phone_number != null && (
          request.auth.token.phone_number == userId ||
          request.auth.token.phone_number == '+' + userId
        ))
      );
    }
    
    // User profile, preferences, and account documents
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }
      
      // Coupons subcollection
      match /coupons/{couponId} {
        allow read, write: if isOwner(userId);
      }

      // Preferences subcollection (including privacy / cookie consent)
      match /preferences/{prefId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Vertical Carts: authenticated users manage their own cart; anonymous users can only manage carts keyed to their own session UID
    match /grokly_carts/{userId} {
      allow read, write: if (request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous' && request.auth.uid == userId) || isOwner(userId);
    }

    match /swadishtt_carts/{userId} {
      allow read, write: if (request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous' && request.auth.uid == userId) || isOwner(userId);
    }

    match /instastyle_carts/{userId} {
      allow read, write: if (request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous' && request.auth.uid == userId) || isOwner(userId);
    }

    // Vertical Wishlists
    match /instastyle_wishlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /grokly_wishlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User Bookmarks — only non-anonymous authenticated owners can read, create, update, or delete their own bookmarks
    match /userBookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && bookmarkId == request.auth.uid + '_' + request.resource.data.blogId;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Catalog & Blogs (Public read, writes disallowed via client SDK — managed by server/Admin SDK APIs)
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if false;
    }

    match /instastyle_products/{productId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Waitlist collection (Public create, authenticated read)
    match /waitlistUsers/{docId} {
      allow create: if true;
      allow read: if isAuthenticated();
    }
    
    // Referral profiles and visits
    match /referralProfiles/{phone} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        (request.auth.token.phone_number != null && (
          request.auth.token.phone_number == phone ||
          request.auth.token.phone_number == '+' + phone
        )) || request.auth.uid == phone
      );
    }
    
    // Referral visits — pre-signup visitor tracking
    match /referralVisits/{visitId} {
      allow read, create, update: if true;
    }
  }
}

# ─────────────────────────────────────────────
# Accesco Living – Virtual Discovery  |  .env
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit the .env file — it contains secrets.
# ─────────────────────────────────────────────

# MongoDB connection string (e.g., Atlas cluster)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/accesco_living?retryWrites=true&w=majority

# Name of the MongoDB database
MONGO_DB_NAME=accesco_living

# Flask secret key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-strong-random-secret

# JWT signing secret — must match the secret used by your auth service.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-jwt-secret

# Debug mode: set to 1 for development (enables auto-reload & debugger).
# Set to 0 for production.
FLASK_DEBUG=1

# Set to 1 ONLY for local development with self-signed MongoDB certificates.
# NEVER enable this in production.
# MONGO_TLS_INSECURE=0

# Production MongoDB connections should use proper CA certificates.
# Uncomment and set this to the absolute path of your CA bundle
# (e.g., /etc/ssl/certs/ca-certificates.crt on Ubuntu).
# MONGO_TLS_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# ── TorchServe Audio Toxicity Microservice ──────────────────────────────
# Set to 1 to enable the TorchServe spectrogram-based audio toxicity check.
# Requires the TorchServe container to be running (see inference_service/).
TORCHSERVE_ENABLED=0
TORCHSERVE_ENDPOINT=http://localhost:8080/predictions/audio_toxicity

# ── MuRIL Multilingual Hate Speech ─────────────────────────────────────
# Set to 1 to enable MuRIL for Indian-language text toxicity classification.
# Requires the trained model in Multilingual-Speech-Moderation/models/muril_classifier/
# Train with: cd Multilingual-Speech-Moderation && python root/train.py
MURIL_ENABLED=0

# ── CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default in code is "*" — MUST be set to your real frontend domain(s) for production.
CORS_ALLOWED_ORIGINS=https://app.accescoliving.com

# ── Rate Limiter Storage ────────────────────────────────────────────
# Default is "memory://" (per-worker, lost on restart).
# For production with multiple Gunicorn workers, use Redis:
RATE_LIMITER_STORAGE_URI=redis://localhost:6379/0

# ── Sentry Error Tracking ───────────────────────────────────────────
# Get your DSN from https://sentry.io — leave blank to disable.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Worker Health Check ─────────────────────────────────────────────
# Port for the background worker's HTTP health endpoint.
# WORKER_HEALTH_PORT=5001

# ── Raw File Retention ──────────────────────────────────────────────
# Set to 0 to keep raw video files after processing (for S3 archival).
# DELETE_RAW_AFTER_PROCESSING=1

# ── Brand Ads & Sponsored Content ───────────────────────────────────
# Admin secret key for registering brands and assigning campaign budgets.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=change-me-to-a-strong-admin-secret

# Default admin password — used by 'flask setup-db' to create the first admin account.
# Set this before running 'flask setup-db'. Remove or unset after initial setup.
# DEFAULT_ADMIN_PASSWORD=change-me-to-a-strong-password

# Ad frequency in feed (default: 5 means 1 ad every 5 organic videos)
# AD_FREQUENCY_IN_FEED=5
